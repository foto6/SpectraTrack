{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spectratrack-error-hypothesis-lineage-v1",
  "title": "SpectraTrack error-analysis hypothesis lineage",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "hypothesis_id", "role", "inspired_by", "hypothesis", "mechanism", "expected_taxonomy_effects"],
  "properties": {
    "schema": {"const": "spectratrack-error-hypothesis-lineage-v1"},
    "hypothesis_id": {"type": "string", "minLength": 1},
    "role": {"enum": ["A1", "A3"]},
    "inspired_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discovery_report_digest", "cluster_ids"],
      "properties": {
        "discovery_report_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "cluster_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "hypothesis": {"type": "string", "minLength": 1},
    "mechanism": {"type": "string", "minLength": 1},
    "expected_taxonomy_effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["category", "direction"],
        "properties": {
          "category": {"enum": ["missed_small_person", "low_contrast_night_darkness", "occlusion_crowd", "localization_iou_miss", "duplicate_fragmented_detection", "background_false_positive", "edge_of_frame", "scale_extreme_aspect", "unknown"]},
          "direction": {"enum": ["decrease", "unchanged", "increase"]}
        }
      }
    }
  }
}
